# 이 값을 설정하면 규칙 기반(fallback) distiller 대신 Claude API로
# 실제 의미 이해 기반 증류/종합을 사용한다. (pip install anthropic 필요)
ANTHROPIC_API_KEY=

# 사용할 모델 (기본값: claude-sonnet-5)
YLEARN_MODEL=claude-sonnet-5

# sqlite DB 파일 경로 (기본값: data/ylearn.db)
YLEARN_DB_PATH=

# 도메인 taxonomy 정의 파일 경로 (기본값: data/domains.yaml)
YLEARN_DOMAINS_PATH=

# 청킹 파라미터 (문자 수 기준)
YLEARN_CHUNK_CHARS=900
YLEARN_CHUNK_OVERLAP=150
